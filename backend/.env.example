# Backend environment (see root .env.example for full key list)
DATABASE_URL=postgresql+psycopg://voyage:voyage@localhost:5432/voyagemind
# Tests: create a voyagemind_test DB and pass DATABASE_URL when running pytest
#   docker compose exec postgres createdb -U voyage voyagemind_test
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-only-secret-change-me-32-bytes-min!
JWT_EXPIRE_MINUTES=60
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
TRAVEL_MCP_URL=http://localhost:8001
CORS_ORIGINS=["http://localhost:3000"]
