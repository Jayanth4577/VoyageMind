# VoyageMind — root environment template
# Copy to .env (and per-service .env files) and fill in real values.
# NEVER commit real keys. Frontend only ever receives NEXT_PUBLIC_* variables.

# ---- LLM providers (pick via LLM_PROVIDER; adapters are pluggable) ----
LLM_PROVIDER=gemini            # gemini | ollama | openai
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---- External data providers (isolated behind the MCP gateway; replaceable) ----
# Weather (Open-Meteo), geocoding, routing (OSRM) and places (OpenStreetMap) need NO keys.
# These two are optional: real flights/search once provided, labeled demo data otherwise.
DUFFEL_API_KEY=                # flight search (Duffel test access) -> set in travel-mcp-server env
TAVILY_API_KEY=                # web search -> set in travel-mcp-server env
TRAVEL_MCP_DEMO_MODE=          # 1 = gateway serves labeled demo data with zero external calls

# ---- Custom Travel MCP Gateway ----
TRAVEL_MCP_URL=http://localhost:8001

# ---- Backend rate limiting (requests/minute per IP; auth stricter) ----
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=15

# ---- Infrastructure (docker-compose defaults) ----
POSTGRES_USER=voyage
POSTGRES_PASSWORD=voyage
POSTGRES_DB=voyagemind
DATABASE_URL=postgresql+psycopg://voyage:voyage@localhost:5432/voyagemind
REDIS_URL=redis://localhost:6379/0

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=60

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
