# VoyageMind — root environment template
# Copy to .env (and per-service .env files) and fill in real values.
# NEVER commit real keys. Frontend only ever receives NEXT_PUBLIC_* variables.

# ---- LLM providers (pick via LLM_PROVIDER; adapters are pluggable) ----
LLM_PROVIDER=gemini            # gemini | ollama | openai | nova
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---- External data providers (isolated behind MCP/tools; replaceable) ----
# Weather: Open-Meteo needs no API key for basic use
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
MAPBOX_TOKEN=
DUFFEL_API_KEY=                # flight/transport search (test access)
CURRENCY_API_KEY=

# ---- Custom Travel MCP Gateway ----
TRAVEL_MCP_URL=http://localhost:8001

# ---- Infrastructure (docker-compose defaults) ----
POSTGRES_USER=voyage
POSTGRES_PASSWORD=voyage
POSTGRES_DB=voyagemind
DATABASE_URL=postgresql+psycopg://voyage:voyage@localhost:5432/voyagemind
REDIS_URL=redis://localhost:6379/0

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=60

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
